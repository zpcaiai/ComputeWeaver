# Runtime
COMPUTEWEAVER_ENV=development
COMPUTEWEAVER_DATABASE_URL=postgresql://computeweaver:replace-me@postgres:5432/computeweaver?sslmode=require
COMPUTEWEAVER_OBJECT_STORE=s3://computeweaver
COMPUTEWEAVER_OBJECT_STORE_ENDPOINT=https://object-store.example.com
COMPUTEWEAVER_OBJECT_STORE_ACCESS_KEY=
COMPUTEWEAVER_OBJECT_STORE_SECRET_KEY=
COMPUTEWEAVER_OBJECT_STORE_CA_BUNDLE=/var/run/secrets/computeweaver/object-store-ca.pem
COMPUTEWEAVER_LOG_LEVEL=INFO
COMPUTEWEAVER_DATABASE_POOL_MIN=1
COMPUTEWEAVER_DATABASE_POOL_MAX=10
COMPUTEWEAVER_DATABASE_CONNECT_TIMEOUT_SECONDS=5
COMPUTEWEAVER_MIGRATION_ON_STARTUP=false

# Authentication: production accepts signed OIDC JWTs only.
COMPUTEWEAVER_AUTH_MODE=oidc
COMPUTEWEAVER_OIDC_ISSUER=https://identity.example.com/
COMPUTEWEAVER_OIDC_AUDIENCE=computeweaver
COMPUTEWEAVER_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
COMPUTEWEAVER_WEB_OIDC_CLIENT_ID=computeweaver-web
COMPUTEWEAVER_WEB_OIDC_SCOPES=openid profile email
COMPUTEWEAVER_CONNECTOR_SECRET_ROOT=/var/run/secrets/computeweaver/connectors
COMPUTEWEAVER_OIDC_JWKS_TTL_SECONDS=300
# Required only when mTLS certificate binding is forwarded by an ingress proxy.
COMPUTEWEAVER_TRUSTED_PROXY_SECRET=

# OpenTelemetry OTLP/HTTP exporter. Leave empty only for local development.
OTEL_SERVICE_NAME=computeweaver-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example.com

# Safety: external mutations require all three settings plus B20 certification.
COMPUTEWEAVER_EXTERNAL_WRITE_ENABLED=false
COMPUTEWEAVER_EXECUTION_MODE=read_only
COMPUTEWEAVER_RELEASE_CERTIFICATE=
COMPUTEWEAVER_RELEASE_PUBLIC_KEY_FILE=/var/run/secrets/computeweaver/release-public-key.pem
COMPUTEWEAVER_RELEASE_REVOCATIONS_FILE=/var/run/computeweaver/evidence/B20/revocations.json
COMPUTEWEAVER_RELEASE_COMMIT=
COMPUTEWEAVER_CERTIFICATION_EVIDENCE_ROOT=/var/run/computeweaver/evidence
COMPUTEWEAVER_RELEASE_ID=

# Guarded provider gateway. The URL is fixed by operators, never supplied by API callers.
COMPUTEWEAVER_EXECUTOR_TARGET=provider-gateway
COMPUTEWEAVER_EXECUTOR_URL=https://provider-gateway.example.com
COMPUTEWEAVER_EXECUTOR_TOKEN=
COMPUTEWEAVER_EXECUTOR_CA_BUNDLE=/var/run/secrets/computeweaver/provider-ca.pem
COMPUTEWEAVER_EXECUTOR_CLIENT_CERT=/var/run/secrets/computeweaver/client.crt
COMPUTEWEAVER_EXECUTOR_CLIENT_KEY=/var/run/secrets/computeweaver/client.key
